<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLyt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".activities.RegisterActivity">

    <TextView
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:text="Borrow Books" />

    <TextView
        android:id="@+id/usernameLabelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_gravity="start"
        android:layout_marginStart="56dp"
        android:text="Username" />

    <EditText
        android:id="@+id/usernameEt"
        android:layout_width="293dp"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:ems="10"
        android:background="@drawable/bg_inputs"
        android:inputType="text"
        android:textSize="16sp"
        android:hint="Enter Username" />

    <TextView
        android:id="@+id/passwordLabelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_gravity="start"
        android:layout_marginStart="56dp"
        android:text="Password" />

    <EditText
        android:id="@+id/passwordEt"
        android:layout_width="295dp"
        android:layout_height="41dp"
        android:layout_marginTop="8dp"
        android:ems="10"
        android:background="@drawable/bg_inputs"
        android:hint="Enter Password"
        android:textSize="16sp"
        android:inputType="textPassword" />

    <LinearLayout
        android:id="@+id/registerBtn"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_button"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/registerButtonTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginRight="225dp"
            android:text="Register"/>

        <TextView
            android:id="@+id/registerIconTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alreadyHaveAccountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account?" />

        <TextView
            android:id="@+id/loginTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Login"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
